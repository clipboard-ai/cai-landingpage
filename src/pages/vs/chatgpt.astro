---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ComparisonPage from '../../components/ComparisonPage.astro';
import Footer from '../../components/Footer.astro';

// Factual claims checked 2026-08-23. ChatGPT macOS: "Work with Apps" reads/edits content in coding apps,
// terminals, and Notes; the 2026 desktop app folds in Codex (runs commands in local repos with approval);
// GitHub connector + MCP apps/dev mode exist. Differentiation must be honest.
// Cai terminology: GitHub/Linear are token-based connectors (NOT MCP); Cai's MCP is the agent-authoring server (v1.6.0).

const data = {
  competitor: {
    name: "ChatGPT",
    url: "https://chatgpt.com"
  },
  tldr: "ChatGPT is a cloud AI chat app, great for deep conversations, research, and complex reasoning. For quick text actions, you switch apps and paste text in. Cai runs actions directly on your selected text, locally on your Mac, without leaving your workflow.",
  features: [
    { name: "Works inline on selected text (no app switch)", cai: true, competitor: "Work with Apps (coding apps, Notes)" },
    { name: "100% local, private by default", cai: true, competitor: false },
    { name: "Free and open source (MIT)", cai: true, competitor: "Free tier (limited)" },
    { name: "No account required", cai: true, competitor: false },
    { name: "Agent-authored actions (Claude Code, Cursor, Codex over MCP)", cai: "Approve a diff with capability chips; runs offline from ⌥C, no tokens", competitor: "Custom GPTs / agents run in ChatGPT's cloud" },
    { name: "Shell command execution", cai: "Custom shell actions on selection", competitor: "Via Codex (coding workflows)" },
    { name: "GitHub & Linear integration", cai: "Built-in (create issues from selection)", competitor: "Via connectors and MCP apps" },
    { name: "Secrets in actions ({{secrets.NAME}}, Keychain)", cai: true, competitor: false },
    { name: "Apple Intelligence support", cai: true, competitor: false },
    { name: "OCR / Image to text on selection", cai: true, competitor: false },
    { name: "Action chains on selected text (AI → script → destination)", cai: true, competitor: false },
    { name: "Long-form multi-turn chat", cai: "Basic (Tab follow-up)", competitor: true },
    { name: "Web search / research mode", cai: false, competitor: true },
    { name: "Image generation", cai: false, competitor: true },
  ],
  whenCompetitor: {
    heading: "When to use ChatGPT",
    points: [
      "You need long-form multi-turn conversations and deep reasoning",
      "You want image generation, web search, or deep research mode",
      "You're working on tasks that require back-and-forth iteration with a cloud model",
      "Privacy is not a hard requirement for what you're working on",
    ]
  },
  whenCai: {
    heading: "When to use Cai",
    points: [
      "You want AI actions on selected text without switching apps or typing a prompt",
      "Privacy matters: your text stays on your Mac by default",
      "You need quick actions like summarize, translate, reply, create a GitHub or Linear ticket",
      "You want a free, open-source tool with no subscription and no account",
      "You want to chain actions on a selection: AI prompt → script → destination, run with one keystroke",
    ]
  },
  relatedComparisons: [
    { name: "Raycast", slug: "raycast" },
    { name: "BoltAI", slug: "boltai" },
    { name: "Alter", slug: "alter" },
  ]
};
---

<Layout
  title="Cai vs ChatGPT — Free Local AI Alternative for Mac"
  description="Compare Cai and ChatGPT for macOS. Cai runs AI actions inline on selected text. Local by default, no account, no subscription. ChatGPT is a cloud chat app. Different tools for different jobs."
  keywords="cai vs chatgpt, chatgpt alternative mac, chatgpt desktop alternative, local ai mac, ai actions macos, free chatgpt alternative, clipboard AI alternative, private ai mac"
>
  <Navbar />
  <ComparisonPage {...data} />
  <Footer />
</Layout>
